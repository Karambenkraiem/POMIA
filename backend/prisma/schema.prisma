generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleUtilisateur {
  operateur
  chef_bloc
  chef_quart
  chef_exploitation
  chef_centrale
  chef_maintenance
  directeur
  guest
  statistique
  md_center_assistant
  admin

  @@map("role_utilisateur")
}

enum FrequenceEssai {
  journalier
  hebdomadaire
  mensuelle
  semestrielle
  annuelle

  @@map("frequence_essai")
}

enum TypeReleveEssai {
  valeur
  potentiometre
  niveaumetre
  selection

  @@map("type_releve_essai")
}

enum StatutEssai {
  a_faire
  effectue
  annule

  @@map("statut_essai")
}

enum TrancheHoraire {
  h00_07h @map("00h_07h")
  h07_14h @map("07h_14h")
  h14_20h @map("14h_20h")
  h20_00h @map("20h_00h")

  @@map("tranche_horaire")
}

enum StatutJournee {
  en_cours
  valide_bloc
  valide_quart
  transmis

  @@map("statut_journee")
}

enum StatutPoste {
  en_cours
  termine
  valide

  @@map("statut_poste")
}

enum TypeManouvre {
  exploitation
  entretien
  permutation
  agc
  incident

  @@map("type_manouvre")
}

enum NaturePuissance {
  PMC
  AGC
  PMS
  PRESELECT
  BASE

  @@map("nature_puissance")
}

enum EtatOT {
  en_cours
  termine
  reporte
  annule

  @@map("etat_ot")
}

enum DisciplineOT {
  mec
  elec
  inst
  civil
  autre

  @@map("discipline_ot")
}

enum TypeMaintenance {
  curatif
  systematique
  preventif

  @@map("type_maintenance")
}

enum ZoneMateriel {
  site
  tg
  alternateur
  auxiliaires

  @@map("zone_materiel")
}

enum StatutDefaut {
  ouvert
  en_cours
  cloture

  @@map("statut_defaut")
}

model Utilisateur {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom               String          @db.VarChar(100)
  prenom            String          @db.VarChar(100)
  matricule         String          @unique @db.VarChar(20)
  role              RoleUtilisateur
  mot_de_passe_hash String          @db.Text
  actif             Boolean         @default(true)
  cree_le           DateTime        @default(now()) @db.Timestamptz(6)
  modifie_le        DateTime        @default(now()) @db.Timestamptz(6)

  journeesValideesBloc  Journee[]         @relation("ValideBlocPar")
  journeesValideesQuart Journee[]         @relation("ValideQuartPar")
  postesChefQuart       Poste[]           @relation("ChefQuart")
  postesChefBloc        Poste[]           @relation("ChefBloc")
  postesOp1             Poste[]           @relation("Operateur1")
  postesOp2             Poste[]           @relation("Operateur2")
  releves_bloc          RelevesChefBloc[]
  releves_op            RelevesOperateur[]
  manouvres             Manouvre[]
  seuilsModifies        SeuilAlarme[]
  defautsCommentes      MaterielDefectueux[] @relation("CommentaireAuteur")
  essaisEffectues       EssaiInstance[]      @relation("EssaiExecutant")
  messagesEnvoyes       Message[]            @relation("MessagesEnvoyes")
  messagesRecus         Message[]            @relation("MessagesRecus")
  consignesCreees       Consigne[]
  reclamationsDemandees Reclamation[]            @relation("ReclamationDemandeur")
  reclamationsCloturees Reclamation[]            @relation("ReclamationCloture")
  reclamationsCommentees ReclamationCommentaire[]

  @@map("utilisateurs")
}

model Journee {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jour                  DateTime      @unique @db.Date
  statut                StatutJournee @default(en_cours)
  consignes_permanentes String?       @db.Text
  valide_bloc_par       String?       @db.Uuid
  valide_bloc_le        DateTime?     @db.Timestamptz(6)
  valide_quart_par      String?       @db.Uuid
  valide_quart_le       DateTime?     @db.Timestamptz(6)
  transmis_le           DateTime?     @db.Timestamptz(6)
  cree_le               DateTime      @default(now()) @db.Timestamptz(6)

  valideBlocUser   Utilisateur?       @relation("ValideBlocPar", fields: [valide_bloc_par], references: [id])
  valideQuartUser  Utilisateur?       @relation("ValideQuartPar", fields: [valide_quart_par], references: [id])
  postes           Poste[]
  releves_bloc     RelevesChefBloc[]
  releves_op       RelevesOperateur[]
  compteurs        CompteursJournaliers?
  manouvres        Manouvre[]
  alarmes          Alarme[]
  ordres_travaux   OrdreTravaux[]
  demandes_service DemandeService[]
  essais           EssaiInstance[]

  @@map("journees")
}

model Poste {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journee_id    String         @db.Uuid
  tranche       TrancheHoraire
  debut         DateTime       @db.Timestamptz(6)
  fin           DateTime       @db.Timestamptz(6)
  chef_quart_id String?        @db.Uuid
  chef_bloc_id  String?        @db.Uuid
  operateur1_id String?        @db.Uuid
  operateur2_id String?        @db.Uuid
  statut        StatutPoste    @default(en_cours)

  journee     Journee          @relation(fields: [journee_id], references: [id], onDelete: Cascade)
  chefQuart   Utilisateur?     @relation("ChefQuart", fields: [chef_quart_id], references: [id])
  chefBloc    Utilisateur?     @relation("ChefBloc", fields: [chef_bloc_id], references: [id])
  operateur1  Utilisateur?     @relation("Operateur1", fields: [operateur1_id], references: [id])
  operateur2  Utilisateur?     @relation("Operateur2", fields: [operateur2_id], references: [id])
  releves_bloc RelevesChefBloc[]
  releves_op   RelevesOperateur[]
  manouvres    Manouvre[]
  alarmes      Alarme[]

  @@unique([journee_id, tranche])
  @@map("postes")
}

model RelevesChefBloc {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journee_id                String    @db.Uuid
  poste_id                  String?   @db.Uuid
