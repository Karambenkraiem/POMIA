  dp_admis_comp_csdp        Decimal?  @db.Decimal(7, 2)
  dp_admission_afpcs        Decimal?  @db.Decimal(7, 2)
  temp_tunnel_ttib1         Decimal?  @db.Decimal(6, 2)
  temp_air_atomisation      Decimal?  @db.Decimal(6, 2)
  vitesse_turbine_rpm       Decimal?  @db.Decimal(8, 2)
  position_tmgv_deg         Decimal?  @db.Decimal(6, 3)
  position_igv_deg          Decimal?  @db.Decimal(6, 3)
  tension_ligne_kv          Decimal?  @db.Decimal(7, 3)
  temp_entree_aeroref_wtad  Decimal?  @db.Decimal(6, 2)
  temp_sortie_aeroref_wtad  Decimal?  @db.Decimal(6, 2)
  temp_patte_turbine1_wttl1 Decimal?  @db.Decimal(6, 2)
  temp_patte_turbine2_wttl2 Decimal?  @db.Decimal(6, 2)
  temp_gaz_ftg_tkg          Decimal?  @db.Decimal(6, 2)
  press_skid_gaz_fpgi       Decimal?  @db.Decimal(7, 3)
  press_avant_srv_fgup      Decimal?  @db.Decimal(7, 3)
  press_inter_vanne_fpg2    Decimal?  @db.Decimal(7, 3)
  debit_massique_fqgm       Decimal?  @db.Decimal(8, 3)
  signal_reference_fsr      Decimal?  @db.Decimal(6, 2)
  press_refoul_cpd          Decimal?  @db.Decimal(7, 3)
  temp_entree_comp_ctifr    Decimal?  @db.Decimal(6, 2)
  temp_sortie_ctd           Decimal?  @db.Decimal(6, 2)
  debit_massique_comp       Decimal?  @db.Decimal(8, 3)
  synced                    Boolean   @default(false)
  deverrouille              Boolean   @default(false)
  cree_le                   DateTime  @default(now()) @db.Timestamptz(6)

  journee     Journee              @relation(fields: [journee_id], references: [id], onDelete: Cascade)
  poste       Poste?               @relation(fields: [poste_id], references: [id])
  saiseur     Utilisateur          @relation(fields: [saisi_par], references: [id])
  generateur  RelevesGenerateur?
  huile       RelevesHuile?
  vibrations  RelevesVibrations?
  echappement RelevesEchappement?
  metal_blanc RelevesMetalBlanc?

  @@unique([journee_id, heure_releve])
  @@map("releves_chef_bloc")
}

