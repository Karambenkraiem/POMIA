  h_gaz_00h            Decimal?        @db.Decimal(8, 1)
  h_gaz_24h            Decimal?        @db.Decimal(8, 1)
  h_gasoil_00h         Decimal?        @db.Decimal(8, 1)
  h_gasoil_24h         Decimal?        @db.Decimal(8, 1)
  dem_manuel_00h       Int?
  dem_manuel_24h       Int?
  dem_total_00h        Int?
  dem_total_24h        Int?
  dem_rapide_00h       Int?
  dem_rapide_24h       Int?
  allumage_00h         Int?
  allumage_24h         Int?
  declenchement_00h    Int?
  declenchement_24h    Int?
  energie_jour_mwh     Decimal?        @db.Decimal(10, 3)
  energie_pointe_mwh   Decimal?        @db.Decimal(10, 3)
  energie_nuit_mwh     Decimal?        @db.Decimal(10, 3)
  puissance_max_mw     Decimal?        @db.Decimal(7, 2)
  heure_puissance_max  String?         @db.VarChar(6)
  temp_amb_puissance_max Decimal?      @db.Decimal(5, 1)
  nature_puissance_max NaturePuissance?
  conso_aux_couplage   Decimal?        @db.Decimal(12, 3)
  conso_aux_decouplage Decimal?        @db.Decimal(12, 3)
  conso_aux_cycles     Json            @default("[]")
  aux_gre_couplage     Decimal?        @db.Decimal(12, 3)
  aux_gre_decouplage   Decimal?        @db.Decimal(12, 3)
  cree_le              DateTime        @default(now()) @db.Timestamptz(6)

  journee Journee @relation(fields: [journee_id], references: [id], onDelete: Cascade)

  @@map("compteurs_journaliers")
}

model Manouvre {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journee_id     String       @db.Uuid
  poste_id       String?      @db.Uuid
  saisi_par      String       @db.Uuid
  heure_manouvre DateTime     @db.Timestamptz(6)
  description    String       @db.Text
  type_manouvre  TypeManouvre @default(exploitation)
  feuille_numero Int          @default(1) @db.SmallInt
  cree_le        DateTime     @default(now()) @db.Timestamptz(6)

  journee Journee      @relation(fields: [journee_id], references: [id], onDelete: Cascade)
  poste   Poste?       @relation(fields: [poste_id], references: [id])
  saiseur Utilisateur  @relation(fields: [saisi_par], references: [id])

  @@map("manouvres")
}

model Alarme {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journee_id String    @db.Uuid
  poste_id   String?   @db.Uuid
  tag        String?   @db.VarChar(50)
  designation String   @db.Text
  equipement String?   @db.VarChar(100)
  heure      DateTime? @db.Timestamptz(6)
  origine    String    @default("HMI") @db.VarChar(20)
  repetitive Boolean   @default(false)
  premiere_apparition DateTime? @db.Date
  cree_le    DateTime  @default(now()) @db.Timestamptz(6)

  journee Journee @relation(fields: [journee_id], references: [id], onDelete: Cascade)
  poste   Poste?  @relation(fields: [poste_id], references: [id])

  @@map("alarmes")
}

model OrdreTravaux {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journee_id       String          @db.Uuid
  numero_ot        String?         @db.VarChar(20)
  kks_equipement   String?         @db.VarChar(50)
  description      String          @db.Text
  date_debut       DateTime?       @db.Date
  date_fin         DateTime?       @db.Date
  etat             EtatOT          @default(en_cours)
  discipline       DisciplineOT?
  type_maintenance TypeMaintenance
  cree_le          DateTime        @default(now()) @db.Timestamptz(6)

  journee Journee @relation(fields: [journee_id], references: [id], onDelete: Cascade)

  @@map("ordres_travaux")
}

model DemandeService {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journee_id String   @db.Uuid
  numero_ds  String?  @unique @db.VarChar(20)
  urgence    Int?     @db.SmallInt
  description String  @db.Text
  cree_le    DateTime @default(now()) @db.Timestamptz(6)

  journee Journee @relation(fields: [journee_id], references: [id], onDelete: Cascade)

  @@map("demandes_service")
}

model MaterielDefectueux {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kks_equipement   String       @db.VarChar(50)
  description      String       @db.Text
  zone             ZoneMateriel
  date_declaration DateTime     @db.Date
  date_cloture     DateTime?    @db.Date
  commentaires     String?      @db.Text
  commentaire_par  String?      @db.Uuid
  commentaire_le   DateTime?    @db.Timestamptz(6)
  statut           StatutDefaut @default(ouvert)
  actif            Boolean?
  cree_le          DateTime     @default(now()) @db.Timestamptz(6)
  modifie_le       DateTime     @default(now()) @db.Timestamptz(6)

  commentaireAuteur Utilisateur? @relation("CommentaireAuteur", fields: [commentaire_par], references: [id])

  @@map("materiels_defectueux")
}

model SeuilAlarme {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parametre   String   @unique @db.VarChar(100)
  valeur_min  Decimal? @db.Decimal(10, 3)
  valeur_max  Decimal? @db.Decimal(10, 3)
  unite       String?  @db.VarChar(20)
  description String?  @db.Text
  actif       Boolean  @default(true)
  modifie_par String?  @db.Uuid
  modifie_le  DateTime @default(now()) @db.Timestamptz(6)

  modificateur Utilisateur? @relation(fields: [modifie_par], references: [id])

  @@map("seuils_alarme")
}

model ActivityLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateur_id String?  @db.Uuid
  matricule      String?  @db.VarChar(20)
  nom_complet    String?  @db.VarChar(200)
  role           String?  @db.VarChar(50)
  methode        String   @db.VarChar(10)
  route          String   @db.Text
  statut         Int
  ip             String?  @db.VarChar(64)
  cree_le        DateTime @default(now()) @db.Timestamptz(6)

  @@map("activity_logs")
  @@index([cree_le])
  @@index([utilisateur_id])
}

// ESSAIS PÉRIODIQUES — paramétrés par le chef d'exploitation, déclenchés
// automatiquement à la création de chaque journée.

model EssaiConfig {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                String         @db.VarChar(200)
  frequence          FrequenceEssai
  jours_semaine      Int[]          @default([])
  actif              Boolean        @default(true)
  derniere_execution DateTime?      @db.Date
  cree_le            DateTime       @default(now()) @db.Timestamptz(6)
  modifie_le         DateTime       @default(now()) @db.Timestamptz(6)

  releves   EssaiReleveConfig[]
  instances EssaiInstance[]

  @@map("essais_config")
}

model EssaiReleveConfig {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  essai_id String          @db.Uuid
  nom      String          @db.VarChar(200)
  type     TypeReleveEssai
  unite    String?         @db.VarChar(20)
  options  Json?
  ordre    Int             @default(0)

  essai EssaiConfig @relation(fields: [essai_id], references: [id], onDelete: Cascade)

  @@map("essais_releve_config")
}

model EssaiInstance {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  essai_id         String      @db.Uuid
  journee_id       String      @db.Uuid
  statut           StatutEssai @default(a_faire)
  motif_annulation String?     @db.Text
  effectue_par     String?     @db.Uuid
  effectue_le      DateTime?   @db.Timestamptz(6)
  valeurs          Json        @default("{}")
  deverrouille     Boolean     @default(false)
  cree_le          DateTime    @default(now()) @db.Timestamptz(6)

  essai     EssaiConfig  @relation(fields: [essai_id], references: [id])
  journee   Journee      @relation(fields: [journee_id], references: [id], onDelete: Cascade)
  executant Utilisateur? @relation("EssaiExecutant", fields: [effectue_par], references: [id])

  @@unique([essai_id, journee_id])
  @@map("essais_instance")
}

// ── Messagerie interne (chat privé entre agents) ──
model Message {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expediteur_id   String   @db.Uuid
  destinataire_id String   @db.Uuid
  contenu         String   @db.Text
  piece_jointe_nom  String? @db.VarChar(255)
  piece_jointe_type String? @db.VarChar(100)
  piece_jointe_data Bytes?
  lu              Boolean  @default(false)
  cree_le         DateTime @default(now()) @db.Timestamptz(6)

  expediteur   Utilisateur @relation("MessagesEnvoyes", fields: [expediteur_id], references: [id])
  destinataire Utilisateur @relation("MessagesRecus", fields: [destinataire_id], references: [id])

  @@index([expediteur_id, destinataire_id])
  @@index([destinataire_id, lu])
  @@map("messages")
}

// ── Consignes du jour (chef exploitation / chef de quart) ──
model Consigne {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  texte      String   @db.Text
  terminee   Boolean  @default(false)
  cree_par   String   @db.Uuid
  date       DateTime @default(now()) @db.Timestamptz(6)
  cree_le    DateTime @default(now()) @db.Timestamptz(6)
  modifie_le DateTime @default(now()) @db.Timestamptz(6)

  auteur Utilisateur @relation(fields: [cree_par], references: [id])

  @@map("consignes")
}

enum StatutReclamation {
  ouverte
  en_cours
  cloturee

  @@map("statut_reclamation")
}

// ── Réclamations / demandes d'assistance MD Center ──
model Reclamation {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titre        String            @db.VarChar(200)
  description  String            @db.Text
  statut       StatutReclamation @default(ouverte)
  demandeur_id String            @db.Uuid
  cloture_par  String?           @db.Uuid
  cloture_le   DateTime?         @db.Timestamptz(6)
  motif_cloture String?          @db.Text
  piece_jointe_nom  String?      @db.VarChar(255)
  piece_jointe_type String?      @db.VarChar(100)
  piece_jointe_data Bytes?
  cree_le      DateTime          @default(now()) @db.Timestamptz(6)
  modifie_le   DateTime          @default(now()) @db.Timestamptz(6)

  demandeur    Utilisateur              @relation("ReclamationDemandeur", fields: [demandeur_id], references: [id])
  clotureur    Utilisateur?             @relation("ReclamationCloture", fields: [cloture_par], references: [id])
  commentaires ReclamationCommentaire[]

  @@map("reclamations")
}

model ReclamationCommentaire {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reclamation_id String   @db.Uuid
  auteur_id      String   @db.Uuid
  contenu        String   @db.Text
  piece_jointe_nom  String?  @db.VarChar(255)
  piece_jointe_type String?  @db.VarChar(100)
  piece_jointe_data Bytes?
  cree_le        DateTime @default(now()) @db.Timestamptz(6)

  reclamation Reclamation @relation(fields: [reclamation_id], references: [id], onDelete: Cascade)
  auteur      Utilisateur @relation(fields: [auteur_id], references: [id])

  @@map("reclamations_commentaires")
}

